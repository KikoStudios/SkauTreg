.sidebar {
    width: var(--sidebar-width);
    background-color: var(--sidebar-bg);
    color: var(--sidebar-text);
    height: 100vh;
    display: flex;
    flex-direction: column;
    position: fixed;
    left: 0;
    top: 0;
    border-right: var(--border-width) solid var(--border-color);
    z-index: 50;
}

.logoArea {
    padding: 1.5rem;
    border-bottom: var(--border-width) solid #333;
}

.logo {
    color: white;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.05em;
    margin: 0;
}

.nav {
    flex: 1;
    padding: 1rem 0;
    overflow-y: auto;
}

.navList {
    list-style: none;
    padding: 0;
    margin: 0;
}

.navItem {
    display: flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.2s;
    gap: 0.75rem;
    color: var(--sidebar-text);
    text-decoration: none;
    cursor: pointer;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    font-family: inherit;
}

.navItem:hover {
    background-color: var(--sidebar-hover-bg);
    color: white;
}

.navItem.active {
    color: var(--sidebar-text-active);
    /* Light Green Active Text */
    background-color: transparent;
    /* Or subtle highlight if needed */
}

/* Maintain exact aesthetic of the image where active item has just color change or subtle indication */
.icon {
    width: 20px;
    display: flex;
    justify-content: center;
}

.separator {
    height: var(--border-width);
    background-color: #333;
    margin: 1rem 0;
}

/* Modal Styles moved to ProfileModal.module.css */